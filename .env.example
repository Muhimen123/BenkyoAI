# Copy to .env.local and fill in what you need. Every variable is optional.

# Dev-only fallback key for the AI routes when no BYOK key is sent.
# GEMINI_API_KEY=

# ---------------------------------------------------------------- /docs access
# With none of these set, /docs is public, always.

# Master switch: false / 0 / off / no hides /docs from everyone but admins.
# DOCS_ENABLED=true

# Public window, ISO 8601 with a timezone offset. Either bound may be left out.
# Example — the showcase window, June 10 00:00 to June 14 23:59 (UTC; use your own offset):
# DOCS_START=2027-06-10T00:00:00+00:00
# DOCS_END=2027-06-14T23:59:00+00:00

# Or instead of DOCS_END: keep /docs open this many hours after DOCS_START.
# DOCS_DURATION_HOURS=120

# Turns on the admin panel at /docs/admin. Use a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Admin changes are held in server memory (until restart, per instance);
# the variables above are the durable setting.
# DOCS_ADMIN_TOKEN=
